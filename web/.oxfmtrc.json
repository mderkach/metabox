{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": false,
  "trailingComma": "es5",
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": [
      "@app/",
      "@pages/",
      "@widgets/",
      "@features/",
      "@entities/",
      "@shared/",
      "@adapters/",
      "@schema"
    ],
    "newlinesBetween": true
  },
  "sortTailwindcss": {
    "stylesheet": "./src/app/styles/index.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": ["dist", "src/schema.generated.ts"]
}
