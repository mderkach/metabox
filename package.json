{
  "name": "metabox",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "openspec": "OPENSPEC_TELEMETRY=0 openspec",
    "spec:check": "OPENSPEC_TELEMETRY=0 openspec validate --specs --no-interactive && OPENSPEC_TELEMETRY=0 openspec validate --changes --no-interactive"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@fission-ai/openspec": "2.1.1",
    "lefthook": "2.2.2",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.21.0"
  },
  "packageManager": "pnpm@12.21.0"
}
