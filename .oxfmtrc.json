{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "es5",
  "ignorePatterns": [
    "dist",
    "apps/web/dist",
    "apps/web/src/shared/api/generated.ts",
    "apps/web/src/shared/api/daemon.generated.ts",
    ".claude",
    ".omc",
    ".devcontainer/target"
  ],
  "overrides": [
    {
      "files": [".markdownlint.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    },
    {
      "files": ["apps/web/**"],
      "options": {
        "sortImports": {
          "groups": [
            "builtin",
            "external",
            ["internal", "subpath"],
            ["parent", "sibling", "index"],
            "style",
            "unknown"
          ],
          "internalPattern": ["@app/", "@pages/", "@widgets/", "@features/", "@entities/", "@shared/", "@adapters/"],
          "newlinesBetween": true
        },
        "sortTailwindcss": {
          "stylesheet": "./apps/web/src/app/styles/index.css",
          "functions": ["cn", "cva"]
        }
      }
    }
  ]
}
