#!/bin/sh /etc/rc.common
# Штатный procd-сервис sing-box. Демон рестартит его тем же способом, что и на роутере.

START=99
USE_PROCD=1

# check вызывается демоном перед применением конфига (AC-13),
# поэтому объявлен как полноценная команда init-скрипта
EXTRA_COMMANDS="check"
EXTRA_HELP="	check	Validate the configuration with sing-box check"

PROG=/usr/bin/sing-box
CONF_DIR=/etc/sing-box
CONF=$CONF_DIR/config.json

start_service() {
	procd_open_instance sing-box
	procd_set_param command "$PROG" -D "$CONF_DIR" -C "$CONF_DIR" run
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "sing-box"
}

check() {
	"$PROG" check -c "$CONF"
}
