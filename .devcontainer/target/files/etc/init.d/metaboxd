#!/bin/sh /etc/rc.common
# Демон панели. Бинарь монтируется из dist/ хоста, поэтому образ не пересобирается на каждую правку.

START=98
USE_PROCD=1

PROG=/opt/metabox/metaboxd
# По умолчанию демон слушает 127.0.0.1 — на стенде это отрезало бы проброс портов
# наружу контейнера. На роутере адрес задаётся отдельно, здесь это стендовая настройка.
LISTEN=0.0.0.0:8080

start_service() {
	[ -x "$PROG" ] || {
		echo "metaboxd: $PROG отсутствует, соберите его: make daemon" >&2
		return 1
	}

	procd_open_instance metaboxd
	procd_set_param command "$PROG" -listen "$LISTEN"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
