#!/bin/sh /etc/rc.common
# Демон панели. Бинарь монтируется из dist/ хоста, поэтому образ не пересобирается на каждую правку.

START=98
USE_PROCD=1

PROG=/opt/metabox/metaboxd
# По умолчанию демон слушает 127.0.0.1 — на стенде это отрезало бы проброс портов
# наружу контейнера. На роутере адрес задаётся отдельно, здесь это стендовая настройка.
LISTEN=0.0.0.0:8080
# Панель на стенде живёт на дев-сервере Vite, а её запросы приходят через его
# прокси: Origin остаётся исходным, и без послабления демон отбивает все
# мутирующие запросы.
DEV_ORIGIN=http://localhost:5173
STATE_DIR=/etc/metabox

start_service() {
	[ -x "$PROG" ] || {
		echo "metaboxd: $PROG отсутствует, соберите его: make daemon" >&2
		return 1
	}

	# Каталог состояния демон сам не заводит, его создаёт init-скрипт: на
	# роутере это делает пакетный скрипт, здесь — стендовый.
	mkdir -p "$STATE_DIR"
	chmod 0700 "$STATE_DIR"

	procd_open_instance metaboxd
	procd_set_param command "$PROG" \
		-listen "$LISTEN" \
		-allowed-origin "$DEV_ORIGIN" \
		-state-dir "$STATE_DIR"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
