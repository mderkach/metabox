# Стендовая конфигурация сети: только loopback.
# Штатный /etc/config/network собирает br-lan из eth0 и вешает 192.168.1.1 — netifd
# при этом отбирает интерфейс у Docker вместе с выданным адресом, и проброс портов
# перестаёт работать. Сетевая подсистема роутера стенду не нужна: eth0 остаётся
# под управлением Docker, procd/ubus/init.d — настоящие.

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'
