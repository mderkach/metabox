# Test bench zones have the same roles as on the router: the wired and guest networks are local,
# the external one is closed for input. Network names are UCI interfaces that stand-init
# builds by address.

config defaults
	option syn_flood '1'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'

config zone
	option name 'lan'
	list network 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'

# Input is open: the panel also listens on the guest network (listen_interface), and
# Docker Desktop delivers the port published to the host to its address; without the zone
# it fell under the default input REJECT.
config zone
	option name 'guest'
	list network 'guest'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'REJECT'

config zone
	option name 'wan'
	list network 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'

config forwarding
	option src 'lan'
	option dest 'wan'

config forwarding
	option src 'guest'
	option dest 'wan'
