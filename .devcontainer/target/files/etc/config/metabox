# Panel settings on the test bench. The package installs its own values meant for
# the router; here the test bench ones are set: another port and the guest network next to the wired one.
# The address is empty: as on the device, it is taken from the networks in listen_interface.

config metabox 'main'
	option enabled '1'
	option listen_addr ''
	option listen_port '8080'
	list listen_interface 'lan'
	list listen_interface 'guest'
	option config_dir '/etc/sing-box'
	option config_name 'config.json'
	option state_dir '/etc/metabox'
	option singbox '/usr/bin/sing-box'
	option init_script '/etc/init.d/metabox-singbox'
	option service_instance 'sing-box'
	option ubus '/bin/ubus'
	option clash_port '9090'
	option log_level 'info'
	# The test bench may have no external DNS: the name is answered by the test bench sing-box itself
	# with a hosts server, without going outside.
	option health_dns_name 'dataplane-check.metabox.example'

# Interception dataplane: from the wired network only the dataplane-check clients go through
# sing-box, one by address, the other by MAC. stand-init substitutes the interface:
# Docker hands out eth* names anew on every start.
config dataplane 'dataplane'
	option enabled '1'
	option redirect_port '5331'
	option tproxy_port '5332'
	option dns_port '5333'
	option dns_hijack '1'
	option self_mark '100'
	option tproxy_mark '101'
	option route_table '100'
	option acl_mode 'listed'
	list source_ip '192.168.210.40/32'
	list source_mac '02:00:00:00:d2:2a'
	list lan_interface 'br-lan'
	option ipv6 '0'
