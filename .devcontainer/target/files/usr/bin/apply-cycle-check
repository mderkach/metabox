#!/bin/sh
# Apply cycle check on the target environment (AC-21): sing-box check → write →
# restart through procd → healthcheck. Then what the file-based lists (AC-8) rely on:
# the service working directory equals the config directory, and a local
# rule-set from rule-sets/ is resolved relative to it. Runs inside the
# target container, used both locally (make apply-check) and in CI (AC-22).
set -eu

CONF_DIR=/etc/sing-box
CONF=$CONF_DIR/config.json
TMP=/tmp/config.candidate.json
API=http://127.0.0.1:9090
SERVICE=metabox-singbox
INSTANCE=sing-box

fail() { echo "FAILED: $1" >&2; exit 1; }

# wait_api waits until the Clash API answers after a restart: the init script
# returns before the service is up.
wait_api() {
	i=0
	while [ $i -lt 30 ]; do
		if wget -qO- "$API/version" >/dev/null 2>&1; then
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	return 1
}

echo "1. Initial state"
/etc/init.d/$SERVICE running $INSTANCE || fail "sing-box is not running before the cycle"
before=$(wget -qO- "$API/version") || fail "Clash API does not answer before the cycle"
echo "   $before"

echo "2. Config candidate: add a routing rule"
# The rule is appended by parsing JSON, not by text replacement: the test bench config
# already has route rules and no empty list to hook onto.
ucode -e "import { readfile } from 'fs';
let c = json(readfile('$CONF'));
push(c.route.rules, { domain_suffix: ['example.com'], outbound: 'direct' });
printf('%.J\\n', c);" > "$TMP"
grep -q example.com "$TMP" || fail "the rule was not substituted, the config template changed"

echo "3. sing-box check on the candidate"
sing-box check -c "$TMP" || fail "check rejected a valid config"

echo "4. A knowingly broken config must be rejected"
echo '{"route": {"rules": [{"outbound": 42}]}}' > /tmp/config.broken.json
if sing-box check -c /tmp/config.broken.json 2>/dev/null; then
	fail "check accepted a knowingly broken config"
fi
echo "   rejected, as it should be"

echo "5. Write and restart through procd"
cp "$TMP" "$CONF"
/etc/init.d/$SERVICE restart

echo "6. Healthcheck"
wait_api || fail "the service did not come up within 30 seconds after the restart"
echo "   Clash API came up after the restart"

echo "7. The applied rule is really in the runtime"
wget -qO- "$API/configs" >/dev/null || fail "Clash API does not return the configuration"
grep -q example.com "$CONF" || fail "the rule was not saved in the config"

echo "8. The service working directory is the config directory"
# sing-box resolves a relative path of a local node from the -D directory, not from
# the config directory: with another working directory the service will not find the list files.
service=$(ubus call service list "{\"name\": \"$SERVICE\"}" | jsonfilter -e "@['$SERVICE'].instances['$INSTANCE']") ||
	fail "procd does not know instance $INSTANCE of service $SERVICE"
workdir=$(echo "$service" | jsonfilter -e '@.command[*]' | awk '
	take { dir = $0; take = 0; next }
	$0 == "-D" || $0 == "--directory" { take = 1; next }
	/^--directory=/ { dir = substr($0, 13) }
	END { print dir }')
[ "$workdir" = "$CONF_DIR" ] || fail "the service started with -D '$workdir', expected $CONF_DIR"
# The daemon checks the candidate in the same mode the service starts in: the service reads
# one -c file, and it must be the config the daemon owns.
configs=$(echo "$service" | jsonfilter -e '@.command[*]' | awk '
	take { print; take = 0; next }
	$0 == "-c" || $0 == "--config" { take = 1; next }
	/^--config=/ { print substr($0, 10) }')
[ "$configs" = "$CONF" ] || fail "the service started with -c '$configs', expected a single file $CONF"
if echo "$service" | jsonfilter -e '@.command[*]' | grep -qx -e '-C' -e '--config-directory' -e '--config-directory=.*'; then
	fail "the service started in directory mode, but its init script starts a single file"
fi
pid=$(echo "$service" | jsonfilter -e '@.pid' | head -1)
[ -n "$pid" ] || fail "procd did not return the service pid"
cwd=$(readlink "/proc/$pid/cwd") || fail "the working directory of process $pid was not read"
[ "$cwd" = "$CONF_DIR" ] || fail "process $pid works in '$cwd', expected $CONF_DIR"
echo "   -c $CONF, -D and the process cwd are $CONF_DIR"

echo "9. List as a file: local rule-set from rule-sets/"
LISTS_DIR=$CONF_DIR/rule-sets
LIST_NAME=metabox-check.json
LIST_BODY='{"version": 1, "rules": [{"domain_suffix": ["metabox-check.example"]}]}'
CANDIDATE=/tmp/metabox-lists-candidate
ORIGINAL=/tmp/config.before-lists.json
lists_dir_created=0

rm -rf "$CANDIDATE"
mkdir -p "$CANDIDATE/rule-sets"
ucode -e "import { readfile } from 'fs';
let c = json(readfile('$CONF'));
unshift(c.route.rules, { rule_set: 'metabox-check', outbound: 'direct' });
c.route.rule_set = [{ type: 'local', tag: 'metabox-check', format: 'source', path: 'rule-sets/$LIST_NAME' }];
printf('%.J\\n', c);" > "$CANDIDATE/config.json"
grep -q '"rule_set": "metabox-check"' "$CANDIDATE/config.json" || fail "the rule with the rule set was not substituted, the config template changed"
grep -q "rule-sets/$LIST_NAME" "$CANDIDATE/config.json" || fail "the rule set was not substituted, the config template changed"
printf '%s\n' "$LIST_BODY" > "$CANDIDATE/rule-sets/$LIST_NAME"

# The candidate is checked the way the daemon checks it: in the same mode as the
# service at step 8, and with -D on itself, otherwise a relative path would be resolved
# from a foreign directory.
sing-box check -D "$CANDIDATE" -c "$CANDIDATE/config.json" || fail "check rejected a candidate with the list file"
rm "$CANDIDATE/rule-sets/$LIST_NAME"
if sing-box check -D "$CANDIDATE" -c "$CANDIDATE/config.json" 2>/dev/null; then
	fail "check accepted a candidate without the list file"
fi
echo "   check: passes with the file, rejected without it"

# restore_lists returns the test bench to the initial state on any exit: the config before step 9,
# without the list file, on a running service. The check exit code is preserved.
restore_lists() {
	code=$?
	trap - EXIT
	echo "   returning the test bench to the initial state"
	cp "$ORIGINAL" "$CONF" || code=1
	rm -f "$LISTS_DIR/$LIST_NAME"
	if [ "$lists_dir_created" = 1 ]; then
		rmdir "$LISTS_DIR" 2>/dev/null || true
	fi
	/etc/init.d/$SERVICE restart || code=1
	if ! wait_api; then
		echo "FAILED: the test bench did not return to the initial state: Clash API is silent after the restart" >&2
		code=1
	fi
	rm -rf "$CANDIDATE" "$ORIGINAL"
	exit $code
}

cp "$CONF" "$ORIGINAL"
trap restore_lists EXIT
trap 'exit 1' INT TERM

# The list file is written before the config: the daemon writes in the same order.
if [ ! -d "$LISTS_DIR" ]; then
	mkdir "$LISTS_DIR"
	lists_dir_created=1
fi
printf '%s\n' "$LIST_BODY" > "$LISTS_DIR/$LIST_NAME"
cp "$CANDIDATE/config.json" "$CONF"
/etc/init.d/$SERVICE restart
wait_api || fail "the service did not come up within 30 seconds with a config referencing the list file"
wget -qO- "$API/rules" | grep -q metabox-check || fail "the rule with the rule set metabox-check is not visible in the runtime"
echo "   the service came up, the rule set metabox-check is in the runtime"

echo
echo "The Apply cycle passed completely (AC-21)."
