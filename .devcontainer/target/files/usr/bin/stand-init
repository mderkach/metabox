#!/bin/sh
# Assigns roles to the test bench networks and hands control to procd.
#
# On the router the interfaces are described by the firmware, here Docker creates them, and the eth*
# names it hands out come in arbitrary order: between two starts the same
# network gets different names. A network can be identified only by its address, so
# /etc/config/network is built at start and is not baked into the image. For the same
# reason the interception interface in the dataplane model is substituted here too.
#
# The default route is restored through the same interface Docker gave it on:
# netifd rewrites the whole routing table, and without a route replies
# to the published port do not reach the host.
set -eu

CONF=/etc/config/network
DEFAULT_ROUTE="$(ip route show default | head -1)"
GATEWAY="$(echo "$DEFAULT_ROUTE" | awk '{ for (i = 1; i < NF; i++) if ($i == "via") print $(i + 1) }')"
GATEWAY_DEVICE="$(echo "$DEFAULT_ROUTE" | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") print $(i + 1) }')"

role_of() {
	case "$1" in
	192.168.210.*) echo lan ;;
	192.168.220.*) echo guest ;;
	192.168.230.*) echo wan ;;
	*) echo "" ;;
	esac
}

netmask_of() {
	full=$(( $1 / 8 ))
	rest=$(( $1 % 8 ))
	mask=""
	octet=0
	i=1

	while [ "$i" -le 4 ]; do
		if [ "$i" -le "$full" ]; then
			octet=255
		elif [ "$i" -eq $(( full + 1 )) ]; then
			octet=$(( 256 - 2 ** ( 8 - rest ) ))
		else
			octet=0
		fi

		mask="${mask:+$mask.}$octet"
		i=$(( i + 1 ))
	done

	printf '%s' "$mask"
}

cat >"$CONF" <<'LOOPBACK'
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'
LOOPBACK

ip -o -4 addr show | while read -r _ device _ cidr _; do
	if [ "$device" = "lo" ]; then
		continue
	fi

	address="${cidr%/*}"
	role="$(role_of "$address")"
	if [ -z "$role" ]; then
		continue
	fi

	cat >>"$CONF" <<INTERFACE

config interface '$role'
	option device '$device'
	option proto 'static'
	option ipaddr '$address'
	option netmask '$(netmask_of "${cidr#*/}")'
INTERFACE

	if [ "$role" = lan ]; then
		uci -q batch <<-DATAPLANE
			delete metabox.dataplane.lan_interface
			add_list metabox.dataplane.lan_interface=$device
			commit metabox
		DATAPLANE
	fi

	if [ "$device" = "$GATEWAY_DEVICE" ] && [ -n "$GATEWAY" ]; then
		printf "\toption gateway '%s'\n" "$GATEWAY" >>"$CONF"
	fi
done

# The container has no kernel of its own: /proc/kmsg is the host's log, and logd reading
# it next to the host's own reader blocks in the kernel for hours (ADR-0066).
mount --bind /dev/null /proc/kmsg

exec /sbin/procd
