#!/bin/sh
# Steps of the interception dataplane check inside the test bench. The host starts the clients in the wired network
# (`make dataplane-check`), and this script reads and changes what
# is visible only from inside the router: nft counters, ip rule, the dnsmasq fragment,
# process pids. Each step is a separate command so the host can interleave them
# with client requests.
set -eu

SERVICE=metabox-singbox
INSTANCE=sing-box
API=http://127.0.0.1:9090
NFT_FILE=/var/run/metabox/fw4_post.nft

fail() {
	echo "FAILED: $1" >&2
	exit 1
}

singbox_pid() {
	ubus call service list "{\"name\": \"$SERVICE\"}" 2>/dev/null |
		jsonfilter -e "@['$SERVICE'].instances['$INSTANCE'].pid" 2>/dev/null || true
}

dnsmasq_pid() {
	pidof dnsmasq || true
}

# Counter of the last rule of the inet fw4 chain whose text contains the pattern:
# in the dataplane chains the general rule comes last, with special cases above it.
counter() {
	nft list chain inet fw4 "$1" 2>/dev/null | grep -F -- "$2" | tail -1 |
		sed -n 's/.*counter packets \([0-9]*\) .*/\1/p'
}

dnsmasq_fragment() {
	ls /tmp/dnsmasq.*.d/metabox.conf 2>/dev/null || true
}

state() {
	echo "nft: $(nft list ruleset | grep -c metabox_) lines with metabox_"
	echo "ip rule: $(ip rule list | grep -c 'fwmark 0x65 lookup 100') fwmark 0x65 rules"
	echo "route table 100: $(ip route show table 100 2>/dev/null | grep -c 'local default dev lo')"
	echo "dnsmasq: fragment '$(dnsmasq_fragment)', pid $(dnsmasq_pid)"
	echo "uci firewall.metabox_post: $(uci -q get firewall.metabox_post || echo none)"
	echo "sing-box: pid $(singbox_pid)"
}

expect_up() {
	[ "$(nft list ruleset | grep -c metabox_)" -gt 0 ] || fail "no metabox_ chains in nft"
	ip rule list | grep -q 'fwmark 0x65 lookup 100' || fail "no ip rule fwmark 0x65"
	ip route show table 100 | grep -q 'local default dev lo' || fail "no local route in table 100"
	grep -q '^server=127.0.0.1#5333$' "$(dnsmasq_fragment)" 2>/dev/null || fail "no dnsmasq fragment"
	[ -n "$(dnsmasq_pid)" ] || fail "dnsmasq is not running"
}

expect_down() {
	n=$(nft list ruleset | grep -c metabox_ || true)
	[ "$n" = 0 ] || fail "after stop nft still has $n lines with metabox_"
	! ip rule list | grep -q 'fwmark 0x65' || fail "after stop ip rule fwmark 0x65 remains"
	[ -z "$(ip route show table 100 2>/dev/null)" ] || fail "after stop table 100 is not empty"
	[ -z "$(dnsmasq_fragment)" ] || fail "after stop the dnsmasq fragment remains"
	! uci -q get firewall.metabox_post >/dev/null || fail "after stop the include firewall.metabox_post remains"
	[ ! -e "$NFT_FILE" ] || fail "after stop $NFT_FILE remains"
}

wait_singbox() {
	i=0
	while [ $i -lt 30 ]; do
		if wget -qO- "$API/version" >/dev/null 2>&1 && [ -n "$(singbox_pid)" ]; then
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	fail "sing-box did not start within 30 seconds"
}

# Snapshot of what Apply must not touch: rules without counters (any packet
# moves them) and the dnsmasq pid.
snapshot() {
	echo "$(nft -s list ruleset | sha256sum | cut -d' ' -f1) dnsmasq=$(dnsmasq_pid)"
}

case "${1:-}" in
state) state ;;
expect-up) expect_up && echo "dataplane in place" ;;
expect-down) expect_down && echo "no dataplane traces" ;;
counter) counter "$2" "$3" ;;
singbox-pid) singbox_pid ;;
wait) wait_singbox ;;
log-has)
	logread | grep -F -- "$2" | grep -q -F -- "$3" || fail "no line with '$2' and '$3' in the sing-box log"
	;;
router-tcp)
	# Outgoing TCP of the router itself: the first packet passes nat output and goes
	# to redirect, while outgoing sing-box traffic with mark 100 bypasses it.
	wget -q -T 3 -O /dev/null http://1.1.1.1/ >/dev/null 2>&1 || true
	;;
router-udp)
	nslookup example.com 1.1.1.1 >/dev/null 2>&1 || true
	;;
foreign-mark-up)
	# Another daemon's trace in nft: a separate table marks router UDP to 1.0.0.1
	# with mark 0x8000, as a daemon setting SO_MARK would. In postrouting the probe is counted
	# by the mark it arrived with: the general tproxy mark counter in mangle_output
	# is also moved by background router UDP.
	nft -f - <<-EOF
		table inet metabox_check_mark {
			chain output {
				type route hook output priority mangle - 10; policy accept;
				ip daddr 1.0.0.1 udp dport 53 meta mark set 0x8000 counter
			}
			chain postrouting {
				type filter hook postrouting priority mangle; policy accept;
				ip daddr 1.0.0.1 udp dport 53 meta mark 0x8000 counter
				ip daddr 1.0.0.1 udp dport 53 meta mark 0x65 counter
			}
		}
	EOF
	nslookup example.com 1.0.0.1 >/dev/null 2>&1 || true
	;;
foreign-mark-counter)
	# $2 is the mark in the nft entry: 0x00008000 or 0x00000065.
	nft list chain inet metabox_check_mark postrouting | grep -F -- "meta mark $2 " |
		sed -n 's/.*counter packets \([0-9]*\) .*/\1/p'
	;;
foreign-mark-down) nft delete table inet metabox_check_mark ;;
src-probe-up)
	# Per-source counters after the dataplane chains: redirect rewrites the destination port
	# to the redirect port, tproxy sets the tproxy mark. The rule-wide dataplane counters
	# are also moved by unrelated traffic of the test bench.
	shift
	port=$(uci -q get metabox.dataplane.redirect_port || echo 5331)
	mark=$(uci -q get metabox.dataplane.tproxy_mark || echo 101)
	{
		echo 'table inet metabox_check_src {'
		echo '	chain prerouting {'
		echo '		type filter hook prerouting priority filter + 10; policy accept;'
		for a in "$@"; do
			echo "		ip saddr $a counter comment \"seen $a\""
			echo "		ip saddr $a tcp dport $port counter comment \"redirected $a\""
			echo "		ip saddr $a meta l4proto udp meta mark $mark counter comment \"tproxy $a\""
		done
		echo '	}'
		echo '}'
	} | nft -f -
	;;
src-counter)
	# $2 is seen, redirected or tproxy, $3 a source address given to src-probe-up.
	nft list chain inet metabox_check_src prerouting | grep -F -- "comment \"$2 $3\"" |
		sed -n 's/.*counter packets \([0-9]*\) .*/\1/p'
	;;
src-probe-down) nft delete table inet metabox_check_src ;;
snapshot) snapshot ;;
apply) /usr/bin/apply-cycle-check >/dev/null ;;
kill)
	pid=$(singbox_pid)
	[ -n "$pid" ] || fail "sing-box is not running"
	kill -9 "$pid"
	echo "$pid"
	;;
acl)
	# The model change goes the same way as in the daemon: UCI and reload through a trigger
	# procd.
	uci set metabox.dataplane.acl_mode="$2"
	uci commit metabox
	reload_config
	sleep 2
	wait_singbox
	;;
exclude)
	# $2 is an intercepted subnet over the listed clients, $3 an excluded address,
	# $4 an excluded MAC. The listed entries stay: the subnet overlaps them in the set.
	uci add_list metabox.dataplane.source_ip="$2"
	uci add_list metabox.dataplane.source_ip_exclude="$3"
	uci add_list metabox.dataplane.source_mac_exclude="$4"
	uci commit metabox
	reload_config
	sleep 2
	wait_singbox
	;;
exclude-off)
	uci del_list metabox.dataplane.source_ip="$2"
	uci delete metabox.dataplane.source_ip_exclude
	uci delete metabox.dataplane.source_mac_exclude
	uci commit metabox
	reload_config
	sleep 2
	wait_singbox
	;;
foreign-up)
	# Another service's trace in the kernel: the same mark 101 and table 100 as the
	# dataplane has, so a disabled service cannot tell them from its own.
	ip rule add fwmark 101 table 100
	ip route replace local 0.0.0.0/0 dev lo table 100
	;;
foreign-down)
	ip rule del fwmark 101 table 100
	ip route flush table 100
	;;
foreign-present)
	ip rule list | grep -q 'fwmark 0x65 lookup 100' || fail "no foreign ip rule fwmark 0x65"
	ip route show table 100 | grep -q 'local default dev lo' || fail "no foreign table 100"
	;;
dataplane)
	# Model only: reload is not called, start and stop are separate steps.
	uci set metabox.dataplane.enabled="$2"
	uci commit metabox
	;;
forget-state) rm -f /var/run/metabox/dataplane.state ;;
stop) /etc/init.d/$SERVICE stop ;;
start) /etc/init.d/$SERVICE start ;;
service-check) /etc/init.d/$SERVICE dataplane_check ;;
config-missing)
	# At boot nobody reads the init script's stderr: the reason must be in syslog.
	config="$(uci -q get metabox.main.config_dir || echo /etc/sing-box)/$(uci -q get metabox.main.config_name || echo config.json)"
	mv "$config" "$config.hidden"
	/etc/init.d/$SERVICE start >/dev/null 2>&1 || true
	pid=$(singbox_pid)
	mv "$config.hidden" "$config"
	[ -z "$pid" ] || fail "sing-box started without a config (pid $pid)"
	logread | grep -F "$SERVICE" | grep -q -F "config $config not found" ||
		fail "no $SERVICE line about the missing config in syslog"
	;;
route-break) ip route flush table "$(uci -q get metabox.dataplane.route_table || echo 100)" ;;
*)
	echo "usage: $0 state|expect-up|expect-down|counter <chain> <pattern>|singbox-pid|wait|log-has <a> <b>|acl all|listed|exclude <subnet> <ip> <mac>|exclude-off <subnet>|router-tcp|router-udp|foreign-mark-up|foreign-mark-counter <mark>|foreign-mark-down|src-probe-up <ip>...|src-counter <kind> <ip>|src-probe-down|snapshot|apply|kill|foreign-up|foreign-down|foreign-present|dataplane 0|1|forget-state|stop|start|service-check|config-missing|route-break" >&2
	exit 2
	;;
esac
