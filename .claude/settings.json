{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 300,
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; claude plugin list 2>/dev/null | grep -q \"oh-my-claudecode@omc\" && exit 0; claude plugin marketplace add \"Yeachan-Heo/oh-my-claudecode#v5.6.1\" >/dev/null 2>&1 && claude plugin install oh-my-claudecode@omc --scope user >/dev/null 2>&1 || echo \"oh-my-claudecode: установка не удалась\" >&2; exit 0"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.claude/settings.local.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./apps/web/src/shared/api/generated.ts)",
      "Edit(./apps/web/src/shared/api/daemon.generated.ts)",
      "Edit(./apps/web/src/i18n.generated.d.ts)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./dist/**)",
      "Edit(./apps/web/dist/**)"
    ],
    "allow": [
      "Bash(make test)",
      "Bash(make daemon)",
      "Bash(make web)",
      "Bash(make schema)",
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make apply-check)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(pnpm lint:fix:*)",
      "Bash(pnpm -C apps/web test:*)",
      "Bash(pnpm -C apps/web build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ]
  }
}
