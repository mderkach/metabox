node_modules
dist
dist-ssr
coverage
*.local
.DS_Store
.omc/
.omx*
.vite

*.local.*
.env
.env.*
!.env.example

# Directory go:embed takes the SPA from: `make daemon` fills it.
# Only .gitkeep stays in git: without a single file go:embed does not build,
# and the Go part would stop building on a clean clone.
!apps/metaboxd/internal/webui/static/
apps/metaboxd/internal/webui/static/*
!apps/metaboxd/internal/webui/static/.gitkeep

# caches and build artifacts, including those from the devcontainer
.pnpm-store/
*.tsbuildinfo
.devcontainer/.env

# schema generator binary: `make schema` builds it into its own directory
/tools/schemagen/schemagen
# same for the contract generator: `go build ./cmd/...` puts it next to the module
/apps/metaboxd/contractgen
.playwright-mcp
# Impeccable: critique history, live-mode sessions, the generated design sidecar and personal
# overrides stay local; `.impeccable/config.json` holds the shared detector exceptions.
**/.impeccable/critique/
**/.impeccable/live/
**/.impeccable/design.json
**/.impeccable/config.local.json

# Owner's working documents: implementation status, debt, interviews and the runbook
# of the owner's router. They sit next to the rest of the documentation and are not part of the repository.
/docs/Status.md
/docs/TechDebt.md
/docs/Interviews.md
/apps/metaboxd/docs/guides/Migration.md
/apps/metaboxd/docs/guides/migration/

# apk signing key: lives only in the repository secret
*.key
*.pem
!keys/metabox-release.pem
