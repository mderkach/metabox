// Markdown в репозитории форматирует oxfmt (`pnpm format`, он же в хуке
// pre-commit). markdownlint — только линтер содержимого: правила, которыми
// владеет форматтер, выключены, иначе редактор требует одного, а хук другого.
{
  "default": true,

  // Абзацы и таблицы пишутся одной строкой, переносы расставляет oxfmt.
  // Иначе линтер ругается почти на каждую таблицу.
  "MD013": false,

  // Выравнивание столбцов таблиц: oxfmt их не выравнивает и ошибкой не
  // считает. Правило спорит с форматтером на каждой таблице.
  "MD060": false,

  // Жирный текст как подзаголовок — принятый стиль: «История изменений» в
  // PRD, «SOLID» и «GRASP» в гайдах фронта.
  "MD036": false,

  // Транскрипты интервью сворачиваются в <details>, иначе документ нечитаем.
  "MD033": { "allowed_elements": ["details", "summary"] },

  // Два интервью в docs/Interviews.md содержат одинаково названные раунды.
  // Дубли внутри одного раздела остаются ошибкой, между разными — нет.
  "MD024": { "siblings_only": true },

  // CLAUDE.md, CLAUDE.local.md и CLAUDE.md проектов — точки входа для
  // AI-инструментов из одной строки `@AGENTS.md`, заголовка у них быть не
  // может. Исключить их нечем: расширение не читает .markdownlintignore и
  // своей настройки путей не имеет, а все настоящие документы репозитория
  // начинаются с заголовка и так.
  "MD041": false
}
