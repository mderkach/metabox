// Markdown in the repository is formatted by oxfmt (`pnpm format`, also in the
// pre-commit hook). markdownlint is a content linter only: the rules the
// formatter owns are disabled, otherwise the editor demands one thing and the hook another.
{
  "default": true,

  // Paragraphs and tables are written on one line, oxfmt places the line breaks.
  // Otherwise the linter complains about almost every table.
  "MD013": false,

  // Table column alignment: oxfmt does not align them and does not
  // treat it as an error. The rule conflicts with the formatter on every table.
  "MD060": false,

  // Bold text as a subheading is the accepted style: "Change history" in the
  // PRD, "SOLID" and "GRASP" in the frontend guides.
  "MD036": false,

  // Interview transcripts are collapsed into <details>, otherwise the document is unreadable.
  "MD033": { "allowed_elements": ["details", "summary"] },

  // Go examples are formatted by gofmt, indented with tabs.
  "MD010": { "ignore_code_languages": ["go"] },

  // Identical headings in different sections are allowed, within one section they are an error.
  "MD024": { "siblings_only": true },

  // Root CLAUDE.md, CLAUDE.local.md and project CLAUDE.md files are entry points for
  // AI tools consisting of a single `@AGENTS.md` line, they cannot have a heading.
  // They cannot be excluded: the extension does not read .markdownlintignore and
  // has no path setting of its own, and all real repository documents
  // start with a heading anyway.
  "MD041": false
}
