# Настройки демона панели и службы sing-box из того же пакета. Умолчания
# указывают на службу metabox-singbox. Переходный режим, в котором sing-box
# поднимает re:HomeProxy, а пути здесь указывают на него, допустим для
# перехода с homeproxy.

config metabox 'main'
	option enabled '1'
	# Пустой адрес означает «взять у интерфейсов из listen_interface».
	option listen_addr ''
	option listen_port '8088'
	# Сети, с которых доступна панель. Гостевую или отдельную беспроводную
	# добавляют сюда же: демон слушает адрес каждой из них и ни одной больше.
	list listen_interface 'lan'
	option config_dir '/etc/sing-box'
	option config_name 'config.json'
	option state_dir '/etc/metabox'
	option singbox '/usr/bin/sing-box'
	option init_script '/etc/init.d/metabox-singbox'
	# Инстанс procd с sing-box. Пустой подходит службе с одним инстансом; у
	# службы с несколькими состояние без него не читается.
	option service_instance 'sing-box'
	option ubus '/bin/ubus'
	option clash_port '9090'
	option log_level 'info'
	# Имя, которое dns-in sing-box обязан разрешить после рестарта, иначе Apply
	# откатывается. Пустое значение выключает эту проверку.
	option health_dns_name 'cloudflare.com'

# Сетевая обвязка службы metabox-singbox: перехват LAN в nft, ip rule для
# tproxy и upstream dnsmasq. Выключена, пока перехватом владеет homeproxy: две
# обвязки разом перехватывали бы один и тот же трафик. Без этой секции служба
# берёт умолчания, а в них обвязка включена.
config dataplane 'dataplane'
	option enabled '0'
	option redirect_port '5331'
	option tproxy_port '5332'
	option dns_port '5333'
	option dns_hijack '1'
	option self_mark '100'
	option tproxy_mark '101'
	option route_table '100'
	# all — через sing-box все источники с lan_interface, listed — только
	# перечисленные в source_ip и source_mac.
	option acl_mode 'listed'
	list lan_interface 'br-lan'
	option ipv6 '0'
