# Settings of the panel daemon and of the metabox-singbox service from the same package: the
# service starts sing-box on the config from config_dir and config_name.

config metabox 'main'
	option enabled '1'
	# An empty address means "take it from the interfaces in listen_interface".
	option listen_addr ''
	option listen_port '8088'
	# Networks the panel is reachable from. A guest or a separate wireless network
	# is added here too: the daemon listens on the address of each of them and no others.
	list listen_interface 'lan'
	# '1' serves the panel over HTTPS with a certificate from the daemon's own root,
	# kept in state_dir/tls, and redirects http on the same port. The root has to be
	# installed on every device from /metabox-ca.crt, so plain http is the default. A pair
	# the router already has, such as the one acme.sh issues for uhttpd, is served instead
	# of the daemon's own when both paths are set; the daemon is restarted after a renewal.
	option https '0'
	option https_cert ''
	option https_key ''
	option config_dir '/etc/sing-box'
	option config_name 'config.json'
	option state_dir '/etc/metabox'
	option singbox '/usr/bin/sing-box'
	option ubus '/bin/ubus'
	option clash_port '9090'
	option log_level 'info'
	# The name that the sing-box dns-in must resolve after a restart, otherwise Apply
	# is rolled back. An empty value disables this check.
	option health_dns_name 'cloudflare.com'
	# Language of the texts the daemon and its init scripts show the operator: en or ru.
	# Set by install.sh; the panel language is chosen in the panel and does not follow it.
	option lang 'en'

# Dataplane of the metabox-singbox service: LAN interception in nft, ip rule for
# tproxy and the dnsmasq upstream. Disabled while another service owns interception: two
# dataplanes would intercept the same traffic at once. Without this section the service
# takes the defaults, and in them the dataplane is enabled.
config dataplane 'dataplane'
	option enabled '0'
	option redirect_port '5331'
	option tproxy_port '5332'
	option dns_port '5333'
	option dns_hijack '1'
	option self_mark '100'
	option tproxy_mark '101'
	option route_table '100'
	# all: all sources with lan_interface go through sing-box, listed: only
	# those listed in source_ip and source_mac.
	option acl_mode 'listed'
	list lan_interface 'br-lan'
	option ipv6 '0'
