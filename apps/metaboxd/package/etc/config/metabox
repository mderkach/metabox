# Настройки демона панели и службы sing-box из того же пакета. На время
# перехода с re:HomeProxy, пока sing-box поднимает он, указываются его пути:
# /etc/homeproxy, proxy.json, /etc/init.d/homeproxy и инстанс proxy.

config metabox 'main'
	option enabled '1'
	# Пустой адрес означает «взять у интерфейсов из listen_interface».
	option listen_addr ''
	option listen_port '8088'
	# Сети, с которых доступна панель. Гостевую или отдельную беспроводную
	# добавляют сюда же: демон слушает адрес каждой из них и ни одной больше.
	list listen_interface 'lan'
	option config_dir '/etc/sing-box'
	option config_name 'config.json'
	option state_dir '/etc/metabox'
	option singbox '/usr/bin/sing-box'
	option init_script '/etc/init.d/metabox-singbox'
	# Инстанс procd с sing-box. Пустой подходит службе с одним инстансом; у
	# службы с несколькими состояние без него не читается.
	option service_instance 'sing-box'
	option ubus '/bin/ubus'
	option clash_port '9090'
	option log_level 'info'
