#!/bin/sh /etc/rc.common
# Демон панели metabox. Настройки берутся из /etc/config/metabox.

START=98
USE_PROCD=1

PROG=/usr/bin/metaboxd

# Адреса берутся у сетей из listen_interface: панель обязана быть доступна со
# всех локальных сетей владельца и ни с одной чужой, а зашитый в скрипт адрес
# разъехался бы с его сетью. Список адресов уходит демону через запятую.
local_addresses() {
	. /lib/functions/network.sh
	local iface addr list=""

	network_flush_cache

	for iface in $1; do
		network_get_ipaddr addr "$iface" || continue
		list="${list:+$list,}$addr:$2"
	done

	echo "$list"
}

start_service() {
	[ -x "$PROG" ] || {
		echo "metaboxd: $PROG отсутствует" >&2
		return 1
	}

	config_load metabox

	local enabled listen_addr listen_port listen_interface listen
	local config_dir config_name state_dir
	local singbox init_script service_instance ubus clash_port log_level

	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get listen_addr main listen_addr ""
	config_get listen_port main listen_port 8088
	config_get listen_interface main listen_interface "lan"
	config_get config_dir main config_dir /etc/sing-box
	config_get config_name main config_name config.json
	config_get state_dir main state_dir /etc/metabox
	config_get singbox main singbox /usr/bin/sing-box
	config_get init_script main init_script /etc/init.d/metabox-singbox
	config_get service_instance main service_instance sing-box
	config_get ubus main ubus /bin/ubus
	config_get clash_port main clash_port 9090
	config_get log_level main log_level info

	if [ -n "$listen_addr" ]; then
		listen="$listen_addr:$listen_port"
	else
		listen="$(local_addresses "$listen_interface" "$listen_port")"
	fi

	[ -n "$listen" ] || {
		echo "metaboxd: у сетей '$listen_interface' нет адресов, задайте listen_addr в /etc/config/metabox" >&2
		return 1
	}

	mkdir -p "$state_dir"
	chmod 0700 "$state_dir"

	procd_open_instance metaboxd
	procd_set_param command "$PROG" \
		-listen "$listen" \
		-config-dir "$config_dir" \
		-config-name "$config_name" \
		-state-dir "$state_dir" \
		-singbox "$singbox" \
		-init-script "$init_script" \
		-service-instance "$service_instance" \
		-ubus "$ubus" \
		-clash-port "$clash_port" \
		-log-level "$log_level"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	local iface

	procd_add_reload_trigger metabox

	# Адреса берутся у сетей: поднятая позже гостевая сеть должна получить
	# панель без ручного рестарта.
	config_load metabox
	config_get iface main listen_interface "lan"

	for iface in $iface; do
		procd_add_reload_interface_trigger "$iface"
	done
}

# Без своей reload_service триггеры выше только перечитали бы конфигурацию, не
# перезапуская процесс, — а адрес задаётся аргументом команды и применяется
# только при старте.
reload_service() {
	stop
	start
}
