#!/bin/sh /etc/rc.common
# The metabox panel daemon. Settings are taken from /etc/config/metabox.

START=98
USE_PROCD=1

PROG=/usr/bin/metaboxd

. /lib/metabox/locale.sh

# Addresses are taken from the networks in listen_interface: the panel must be reachable from
# all local networks of the owner and from no foreign one, and an address hardcoded in the script
# would diverge from their network. The address list goes to the daemon comma-separated.
local_addresses() {
	. /lib/functions/network.sh
	local iface addr list=""

	network_flush_cache

	for iface in $1; do
		network_get_ipaddr addr "$iface" || continue
		list="${list:+$list,}$addr:$2"
	done

	echo "$list"
}

start_service() {
	[ -x "$PROG" ] || {
		mb_msg metaboxd "%s is missing" "$PROG"
		return 1
	}

	config_load metabox

	local enabled listen_addr listen_port listen_interface listen
	local config_dir config_name state_dir
	local singbox init_script service_instance ubus clash_port log_level health_dns_name
	local https https_cert https_key lang

	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get listen_addr main listen_addr ""
	config_get listen_port main listen_port 8088
	config_get listen_interface main listen_interface "lan"
	config_get config_dir main config_dir /etc/sing-box
	config_get config_name main config_name config.json
	config_get state_dir main state_dir /etc/metabox
	config_get singbox main singbox /usr/bin/sing-box
	config_get init_script main init_script /etc/init.d/metabox-singbox
	config_get service_instance main service_instance sing-box
	config_get ubus main ubus /bin/ubus
	config_get clash_port main clash_port 9090
	config_get log_level main log_level info
	config_get health_dns_name main health_dns_name cloudflare.com
	config_get_bool https main https 0
	config_get https_cert main https_cert ""
	config_get https_key main https_key ""
	config_get lang main lang en

	# The daemon refuses an unknown language at start; a typo in UCI must not take the panel down.
	case "$lang" in
	en | ru) ;;
	*) lang=en ;;
	esac

	if [ -n "$listen_addr" ]; then
		listen="$listen_addr:$listen_port"
	else
		listen="$(local_addresses "$listen_interface" "$listen_port")"
	fi

	[ -n "$listen" ] || {
		mb_msg metaboxd "network '%s' has no addresses, set listen_addr in /etc/config/metabox" "$listen_interface"
		return 1
	}

	mkdir -p "$state_dir"
	chmod 0700 "$state_dir"

	procd_open_instance metaboxd
	procd_set_param command "$PROG" \
		-listen "$listen" \
		-https="$https" \
		-https-cert "$https_cert" \
		-https-key "$https_key" \
		-config-dir "$config_dir" \
		-config-name "$config_name" \
		-state-dir "$state_dir" \
		-singbox "$singbox" \
		-init-script "$init_script" \
		-service-instance "$service_instance" \
		-ubus "$ubus" \
		-clash-port "$clash_port" \
		-log-level "$log_level" \
		-health-dns-name "$health_dns_name" \
		-lang "$lang"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	local iface

	procd_add_reload_trigger metabox

	# Addresses are taken from the networks: a guest network that comes up later must get
	# the panel without a manual restart.
	config_load metabox
	config_get iface main listen_interface "lan"

	for iface in $iface; do
		procd_add_reload_interface_trigger "$iface"
	done
}

# Without its own reload_service the triggers above would only reread the configuration without
# restarting the process, while the address is set by a command argument and applies
# only at start.
reload_service() {
	stop
	start
}
