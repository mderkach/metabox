#!/bin/sh /etc/rc.common
# Демон панели metabox. Настройки берутся из /etc/config/metabox.

START=98
USE_PROCD=1

PROG=/usr/bin/metaboxd

# Адрес по умолчанию берётся у интерфейса lan: демон обязан слушать только его
# (AC-18), а зашитый в скрипт адрес разъехался бы с сетью владельца.
lan_address() {
	. /lib/functions/network.sh
	local addr
	network_flush_cache
	network_get_ipaddr addr lan && echo "$addr"
}

start_service() {
	[ -x "$PROG" ] || {
		echo "metaboxd: $PROG отсутствует" >&2
		return 1
	}

	config_load metabox

	local enabled listen_addr listen_port
	local config_dir config_name state_dir
	local singbox init_script ubus clash_port log_level

	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get listen_addr main listen_addr ""
	config_get listen_port main listen_port 8088
	config_get config_dir main config_dir /etc/sing-box
	config_get config_name main config_name config.json
	config_get state_dir main state_dir /etc/metabox
	config_get singbox main singbox /usr/bin/sing-box
	config_get init_script main init_script /etc/init.d/sing-box
	config_get ubus main ubus /bin/ubus
	config_get clash_port main clash_port 9090
	config_get log_level main log_level info

	[ -n "$listen_addr" ] || listen_addr="$(lan_address)"
	[ -n "$listen_addr" ] || {
		echo "metaboxd: адрес lan не определён, задайте listen_addr в /etc/config/metabox" >&2
		return 1
	}

	mkdir -p "$state_dir"
	chmod 0700 "$state_dir"

	procd_open_instance metaboxd
	procd_set_param command "$PROG" \
		-listen "$listen_addr:$listen_port" \
		-config-dir "$config_dir" \
		-config-name "$config_name" \
		-state-dir "$state_dir" \
		-singbox "$singbox" \
		-init-script "$init_script" \
		-ubus "$ubus" \
		-clash-port "$clash_port" \
		-log-level "$log_level"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger metabox
	# Адрес берётся у lan: смена сети должна поднимать демон на новом адресе.
	procd_add_reload_interface_trigger lan
}

# Без своей reload_service триггеры выше только перечитали бы конфигурацию, не
# перезапуская процесс, — а адрес задаётся аргументом команды и применяется
# только при старте.
reload_service() {
	stop
	start
}
