{
  // Disabled: what the repository oxlint already checks, with its own
  // exceptions that react-doctor does not see: the vendored shadcn zone
  // (`src/shared/ui/**`) and the linter plugins (`tools/**`) are excluded from
  // some rules in `.oxlintrc.json`. Without this list every run reports about
  // two hundred findings that the repository already accepted as the norm.
  //
  // The config does not set the scan scope: the `exclude`, `ignore` and
  // `ignorePatterns` keys do not work in 0.9.14, and the CLI does not accept
  // several directories in its arguments.
  "rules": {
    "eslint/no-magic-numbers": "off",
    "no-magic-numbers": "off",
    "unicorn/filename-case": "off",
    "react/function-component-definition": "off",
    "react/only-export-components": "off",
    "react-doctor/only-export-components": "off",
    "tailwind/no-restricted-classes": "off",
    "tailwind/no-unknown-classes": "off",
    "import/no-default-export": "off",
    "jsx-a11y/label-has-associated-control": "off",
    // The virtualized table is built from roles out of necessity: absolute
    // positioning of rows inside `table` breaks parsing by assistive
    // technologies. The same exception is in `.oxlintrc.json`.
    "react-doctor/prefer-tag-over-role": "off",
    "jsx-a11y/prefer-tag-over-role": "off",

    // Below are rules that are false not in one place but by the design of the panel.
    //
    // The cache is reset after a config is applied not by the mutation handler
    // but by the transaction moving to a terminal phase: the device changes the
    // file not at the moment of the response to the request. The connection
    // list arrives as a stream bypassing Query, so there is nothing to reset
    // there at all.
    "react-doctor/query-mutation-missing-invalidation": "off",
    // The config text editor is recreated by `key` with the document refresh
    // counter, so an external edit reaches the uncontrolled field.
    "react-doctor/no-derived-useState": "off",
    // Triggers only in the vendored shadcn zone, and it cannot be excluded by
    // config: the scope keys do not work in 0.9.14.
    "react-doctor/no-array-index-as-key": "off",
  },
}
