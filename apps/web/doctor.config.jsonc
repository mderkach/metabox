{
  // Выключено то, что репозиторный oxlint уже проверяет — но со своими
  // исключениями, которых react-doctor не видит: вендорная зона shadcn
  // (`src/shared/ui/**`) и плагины линтера (`tools/**`) выведены из-под части
  // правил в `.oxlintrc.json`. Без этого списка каждый прогон отдаёт около
  // двухсот замечаний, которые репозиторий уже принял как норму.
  //
  // Область сканирования конфигом не задаётся: ключи `exclude`, `ignore` и
  // `ignorePatterns` в 0.9.14 не действуют, а несколько каталогов в аргументах
  // CLI не принимает.
  "rules": {
    "eslint/no-magic-numbers": "off",
    "no-magic-numbers": "off",
    "unicorn/filename-case": "off",
    "react/function-component-definition": "off",
    "react/only-export-components": "off",
    "react-doctor/only-export-components": "off",
    "tailwind/no-restricted-classes": "off",
    "tailwind/no-unknown-classes": "off",
    "import/no-default-export": "off",
    "jsx-a11y/label-has-associated-control": "off",
    // Виртуализованная таблица собрана ролями вынужденно: абсолютное
    // позиционирование строк внутри `table` ломает разбор вспомогательными
    // технологиями. То же исключение стоит и в `.oxlintrc.json`.
    "react-doctor/prefer-tag-over-role": "off",
    "jsx-a11y/prefer-tag-over-role": "off",

    // Ниже — правила, ложные не в отдельном месте, а по устройству панели.
    //
    // Кэш после применения конфига сбрасывает не обработчик мутации, а переход
    // транзакции в конечную фазу: устройство меняет файл не в момент ответа на
    // запрос. Список соединений идёт потоком мимо Query, и сбрасывать там
    // нечего вовсе.
    "react-doctor/query-mutation-missing-invalidation": "off",
    // Текстовый редактор конфига пересоздаётся по `key` со счётчиком обновлений
    // документа — так внешняя правка доходит до неконтролируемого поля.
    "react-doctor/no-derived-useState": "off",
    // Срабатывает только в вендорной зоне shadcn, а исключить её конфигом
    // нельзя: ключи области действия в 0.9.14 не работают.
    "react-doctor/no-array-index-as-key": "off",
  },
}
