{
  // Конфиг собран руками: комментарии, свой порядок ключей, табы в одной секции.
  "log": { "level": "info", "timestamp": true },

  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "secret": "REDACTED",
    },
  },

  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "198.51.100.1",
      "listen_port": 2080,
    },
  ],

  "outbounds": [
    { "type": "direct", "tag": "direct" },
    {
      "type": "vless",
      // Узел с Reality: ключ и short_id — с сервера.
      "tag": "node-a",
      "server": "node-a.example",
      "server_port": 443,
      "uuid": "REDACTED",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "node-a.example",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "REDACTED",
          "short_id": "REDACTED",
        },
      },
    },
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": ["node-a", "direct"],
      "default": "node-a",
    },
  ],

  "route": {
    /* Порядок правил и есть логика: первое подходящее выигрывает. */
    "rules": [
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "ip_is_private": true, "outbound": "direct" },
      {
        "domain_suffix": [".example", ".invalid"],
        "outbound": "direct",
      },
      { "port": [80, 443], "outbound": "proxy" },
    ],
    "final": "proxy",
    "auto_detect_interface": true,
  },
}
