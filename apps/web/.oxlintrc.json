{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["react", "typescript", "oxc", "unicorn", "import", "vitest", "jsx-a11y"],
  "jsPlugins": [
    "./tools/fsdBoundaries.js",
    "./tools/projectRules.js",
    {
      "name": "query",
      "specifier": "@tanstack/eslint-plugin-query"
    },
    {
      "name": "tailwind",
      "specifier": "eslint-plugin-better-tailwindcss"
    },
    {
      "name": "check-file",
      "specifier": "eslint-plugin-check-file"
    },
    {
      "name": "testing-library",
      "specifier": "eslint-plugin-testing-library"
    },
    {
      "name": "jest-dom",
      "specifier": "eslint-plugin-jest-dom"
    }
  ],
  "settings": {
    "better-tailwindcss": {
      "cwd": "./apps/web",
      "entryPoint": "src/app/styles/index.css"
    }
  },
  "ignorePatterns": ["dist", "src/shared/api/generated.ts", "src/shared/api/daemon.generated.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/no-unstable-nested-components": "error",
    "react/function-component-definition": [
      "error",
      {
        "namedComponents": "function-declaration",
        "unnamedComponents": "arrow-function"
      }
    ],
    "react/incompatible-library": "off",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-ambiguous-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "FC": "Компонент объявляется как Function Declaration, пропсы типизируются в аргументах.",
          "React.FC": "Компонент объявляется как Function Declaration, пропсы типизируются в аргументах.",
          "VFC": "React.VFC деприкейтнут, компонент объявляется как Function Declaration.",
          "React.VFC": "React.VFC деприкейтнут, компонент объявляется как Function Declaration."
        }
      }
    ],
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/expect-expect": "error",
    "vitest/consistent-test-filename": [
      "error",
      {
        "pattern": ".*\\.test\\.tsx?$",
        "allTestPattern": ".*\\.(test|spec)\\.[jt]sx?$"
      }
    ],
    "fsd/boundaries": "error",
    "project/no-query-destructuring": "error",
    "project/named-effect": "error",
    "fsd/slice-name": "error",
    "query/exhaustive-deps": "error",
    "query/no-rest-destructuring": "error",
    "query/stable-query-client": "error",
    "query/no-unstable-deps": "error",
    "query/no-void-query-fn": "error",
    "query/infinite-query-property-order": "error",
    "query/mutation-property-order": "error",
    "tailwind/no-unknown-classes": "error",
    "tailwind/no-conflicting-classes": "error",
    "tailwind/no-duplicate-classes": "error",
    "tailwind/no-restricted-classes": [
      "error",
      {
        "restrict": [
          {
            "pattern": "^-?[wh]-\\[.*\\]$",
            "message": "Жёсткие размеры не проставляем: компонент занимает место по сетке."
          },
          {
            "pattern": "^-?(?:size|min-w|max-w|min-h|max-h|basis|text|leading|tracking|gap|gap-x|gap-y|p|px|py|pt|pr|pb|pl|m|mx|my|mt|mr|mb|ml|space-x|space-y|top|right|bottom|left|inset|inset-x|inset-y)-\\[-?[0-9.]+px\\]$",
            "message": "Кегль, отступы и размеры — в rem: они обязаны масштабироваться вместе с настройкой шрифта у пользователя. px остаётся границам, focus-ring и теням."
          }
        ]
      }
    ],
    "check-file/filename-naming-convention": [
      "error",
      {
        "src/+(entities|features|widgets|pages)/**/!(index).{ts,tsx}": "PASCAL_CASE"
      },
      {
        "ignoreMiddleExtensions": true
      }
    ],
    "check-file/folder-naming-convention": [
      "error",
      {
        "src/entities/*/": "PASCAL_CASE",
        "src/features/*/": "PASCAL_CASE",
        "src/widgets/*/": "PASCAL_CASE",
        "src/pages/*/": "PASCAL_CASE"
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/require-await": "error",
    "typescript/return-await": "error",
    "typescript/promise-function-async": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-return-this-type": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/unbound-method": "error",
    "typescript/no-redundant-type-constituents": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**"],
      "rules": {
        "no-magic-numbers": "off",
        "react/only-export-components": "off",
        "testing-library/prefer-screen-queries": "error",
        "testing-library/prefer-presence-queries": "error",
        "testing-library/prefer-find-by": "error",
        "testing-library/prefer-user-event": "error",
        "testing-library/no-container": "error",
        "testing-library/no-node-access": "error",
        "testing-library/no-debugging-utils": "error",
        "testing-library/no-render-in-lifecycle": "error",
        "testing-library/no-wait-for-multiple-assertions": "error",
        "testing-library/await-async-queries": "error",
        "testing-library/await-async-events": "error",
        "testing-library/await-async-utils": "error",
        "testing-library/no-await-sync-queries": "error",
        "testing-library/no-await-sync-events": "error",
        "jest-dom/prefer-in-document": "error",
        "jest-dom/prefer-to-have-text-content": "error",
        "jest-dom/prefer-to-have-value": "error",
        "jest-dom/prefer-to-have-class": "error",
        "jest-dom/prefer-to-have-attribute": "error",
        "jest-dom/prefer-checked": "error",
        "jest-dom/prefer-enabled-disabled": "error",
        "jest-dom/prefer-required": "error",
        "jest-dom/prefer-empty": "error",
        "jest-dom/prefer-focus": "error"
      }
    },
    {
      "files": ["src/**/*.mock.ts", "src/**/*.fixture.ts"],
      "rules": {
        "no-magic-numbers": "off"
      }
    },
    {
      "files": ["src/shared/ui/shadcn/**"],
      "rules": {
        "react/only-export-components": "off",
        "react/function-component-definition": "off",
        "unicorn/filename-case": "off",
        "no-magic-numbers": "off",
        "tailwind/no-unknown-classes": "off",
        "tailwind/no-restricted-classes": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/promise-function-async": "off"
      }
    },
    {
      "files": ["src/shared/ui/styles.ts"],
      "rules": {
        "react/only-export-components": "error",
        "react/function-component-definition": "error",
        "unicorn/filename-case": "error",
        "no-magic-numbers": "error",
        "tailwind/no-unknown-classes": [
          "error",
          {
            "variables": [
              [
                "^[A-Z][A-Z0-9_]*$",
                [
                  {
                    "match": "strings"
                  }
                ]
              ]
            ]
          }
        ],
        "tailwind/no-restricted-classes": [
          "error",
          {
            "restrict": [
              {
                "pattern": "^-?[wh]-\\[.*\\]$",
                "message": "Жёсткие размеры не проставляем: компонент занимает место по сетке."
              },
              {
                "pattern": "^-?(?:size|min-w|max-w|min-h|max-h|basis|text|leading|tracking|gap|gap-x|gap-y|p|px|py|pt|pr|pb|pl|m|mx|my|mt|mr|mb|ml|space-x|space-y|top|right|bottom|left|inset|inset-x|inset-y)-\\[-?[0-9.]+px\\]$",
                "message": "Кегль, отступы и размеры — в rem: они обязаны масштабироваться вместе с настройкой шрифта у пользователя. px остаётся границам, focus-ring и теням."
              }
            ],
            "variables": [
              [
                "^[A-Z][A-Z0-9_]*$",
                [
                  {
                    "match": "strings"
                  }
                ]
              ]
            ]
          }
        ],
        "jsx-a11y/label-has-associated-control": "error",
        "typescript/strict-boolean-expressions": "error",
        "typescript/no-unsafe-type-assertion": "error",
        "typescript/no-unnecessary-condition": "error",
        "typescript/promise-function-async": "error"
      }
    },
    {
      "files": ["tools/**"],
      "rules": {
        "import/no-default-export": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/no-confusing-void-expression": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    }
  ]
}
