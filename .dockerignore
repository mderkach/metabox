# The build context is the repository root: the image needs .nvmrc and package.json,
# which sit above .devcontainer. Everything heavy and machine-specific stays out.
.git
node_modules
**/node_modules
.pnpm-store
dist
# Binary for the target system: the panel package for the test bench is built from it.
!dist/metaboxd-linux-arm64
!dist/metaboxd-linux-amd64
apps/web/dist
apps/metaboxd/internal/webui/static/assets
bin
.omc
